{%- comment -%} One line, market-aware: the free-shipping amount follows the visitor's currency. {%- endcomment -%}
{%- liquid
  assign threshold = 0
  assign lines = settings.free_shipping_thresholds | newline_to_br | split: '<br />'
  for raw in lines
    assign pair = raw | strip | split: ':'
    if pair[0] == cart.currency.iso_code
      assign threshold = pair[1] | strip | times: 100
    endif
  endfor
  assign threshold_money = threshold | money_without_trailing_zeros
-%}
<div class="announce">
  {%- if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif -%}
  {%- if threshold > 0 -%}
    {{ section.settings.text | replace: '[threshold]', threshold_money }}
  {%- else -%}
    {{ section.settings.fallback }}
  {%- endif -%}
  {%- if section.settings.link != blank %}</a>{% endif -%}
</div>

{% schema %}
{
  "name": "Announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over [threshold] · Pause or skip your subscription anytime", "info": "[threshold] becomes the free-shipping amount in the visitor's currency." },
    { "type": "text", "id": "fallback", "label": "Text when no threshold applies", "default": "Shipping worldwide from Bali · Pause or skip anytime" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
